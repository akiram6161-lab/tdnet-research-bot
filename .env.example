# TDnet
# 公開APIは存在しないため公式開示リストページを取得する(キー不要)。
# 将来APIを利用する場合のみ設定する。
TDNET_API_KEY=
TDNET_API_BASE_URL=

# Claude Code(自動リサーチ用・サブスクリプション認証)
# `claude setup-token` で発行したトークン。ローカル実行でCLIログイン済みなら不要
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CLI=claude

# EDINET DB(リサーチ時にClaude Codeが使用・任意)
EDINET_DB_API_KEY=
EDINET_DB_BASE_URL=https://edinetdb.jp/v1

# J-Quants(リサーチ時にClaude Codeが使用・任意)
# 既存環境は v2 API の静的キー(JQUANTS_API_KEY)を使用
JQUANTS_API_KEY=

# Slack
SLACK_BOT_TOKEN=
SLACK_USER_TOKEN=
SLACK_CHANNEL_ID=
SLACK_ALLOWED_USER_IDS=

# Runtime
TZ=Asia/Tokyo
MONITOR_START=07:45
MONITOR_END=20:00
LOOKBACK_MINUTES=30
THREAD_POLLING_DAYS=14
MAX_RESEARCH_JOBS_PER_RUN=2
RESEARCH_SCORE_THRESHOLD=80
MAX_AUTO_RESEARCH_PER_DAY=15
DIGEST_AFTER=19:45
STATE_RETENTION_DAYS=90
LOG_LEVEL=INFO
